# Monthly Gmail pull, then normalize and import the new messages.
# Adjust paths. Logs go to the work directory.
0 3 1 * * cd /path/to/email-consolidator && python3 emailc.py gmail pull >> /path/to/work/gmail-cron.log 2>&1 && python3 emailc.py normalize maildir "/path/to/archive/gmail/you@gmail.com/All Mail" gmail/you@gmail.com >> /path/to/work/gmail-cron.log 2>&1 && python3 emailc.py import run --only Archive/gmail --workers 1 >> /path/to/work/gmail-cron.log 2>&1
